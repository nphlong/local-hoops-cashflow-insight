# HMAC + optional Fernet wrapping for data/curated/local_hoops.sqlite
SQLITE_KEY=replace-with-a-long-random-string

# Python API
API_HOST=127.0.0.1
API_PORT=8000

# --- Google Sign-In (GIS) ---
# Copy these into .env.local for Vite. Never put the OAuth client secret here.
#
# Google Cloud Console (https://console.cloud.google.com/):
# 1. Create or select a project (e.g. local-hoops-dashboard). Billing is not required.
# 2. APIs & Services → OAuth consent screen (or Google Auth Platform → Get started)
#    - User type: External
#    - App name: Local Hoops financial dashboard
#    - Support / developer contact: your Gmail
#    - App domain / logo: skip
#    - Scopes only: openid, userinfo.email, userinfo.profile
#      Do NOT add Gmail API or mail scopes.
#    - Publishing status: Testing (no verification; 100 test users max)
# 3. Audience → Test users: add every Gmail that should sign in (same as ALLOWED_EMAILS).
# 4. Credentials → Create credentials → OAuth client ID → Web application
#    Name: Local Hoops web
#    Authorized JavaScript origins (exact, no path):
#      http://localhost:3000
#      http://127.0.0.1:3000
#      https://nphlong.github.io
#    Authorized redirect URIs: leave empty (GIS uses a popup, not a redirect).
# 5. Copy the Client ID (….apps.googleusercontent.com). Skip enabling Gmail API.
#
# GitHub Pages: add the same two keys as repository Actions secrets so pages.yml can inject them at build.

VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
VITE_GOOGLE_ALLOWED_EMAILS=you@gmail.com,other@gmail.com
