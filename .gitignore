data/raw/*
!data/raw/.gitkeep
data/curated/*
!data/curated/.gitkeep
*.xlsx
*.sqlite
*.sqlite-journal
*.sqlite.enc

# Test / tool caches
.pytest_cache/
**/.pytest_cache/
